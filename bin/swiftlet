#!/usr/bin/python3 -I
# Launcher installed as /usr/bin/swiftlet. "-I" (isolated mode) ignores
# PYTHON* environment variables, the user site directory and the current
# directory, so nothing outside the package can be imported by accident.
import sys

sys.path.insert(0, "/usr/share/swiftlet")

from swiftlet.__main__ import main  # noqa: E402

sys.exit(main())
