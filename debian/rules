#!/usr/bin/make -f
export PYBUILD_DISABLE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --with python3

override_dh_auto_install:
	$(MAKE) install DESTDIR=$(CURDIR)/debian/swiftlet PREFIX=/usr

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	QT_QPA_PLATFORM=offscreen python3 tools/check_py38.py
	QT_QPA_PLATFORM=offscreen python3 -m pytest -q -p no:cacheprovider tests
endif

override_dh_python3:
	dh_python3 /usr/share/swiftlet
